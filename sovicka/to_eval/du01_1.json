  "3057": {
    "solution": [
      {
        "msg": "$$\\lVert\\bold{u} + \\bold{v}\\rVert^2 =\\langle \\bold{u}+\\bold{v}, \\bold{u}+\\bold{v} \\rangle = \\langle \\bold{u}, \\bold{u}\\rangle + \\langle \\bold{u}, \\bold{v}\\rangle + \\langle \\bold{v}, \\bold{u}\\rangle + \\langle \\bold{v}, \\bold{v}\\rangle$$\n\n$$\n\\begin{align*}\n\\lVert\\bold{u} - \\bold{v}\\rVert^2 &=\\langle \\bold{u}-\\bold{v}, \\bold{u}-\\bold{v} \\rangle = \\langle \\bold{u}, \\bold{u}\\rangle + \\langle \\bold{u}, -\\bold{v}\\rangle + \\langle -\\bold{v}, \\bold{u}\\rangle + \\langle -\\bold{v}, -\\bold{v}\\rangle \\\\\n&=\\langle \\bold{u}, \\bold{u}\\rangle - \\langle \\bold{u}, \\bold{v}\\rangle - \\langle \\bold{v}, \\bold{u}\\rangle + \\langle \\bold{v}, \\bold{v}\\rangle\n\\end{align*}\n$$\n\nOdčítaním dostávame:\n$$\\lVert\\bold{u} + \\bold{v}\\rVert^2 - \\lVert\\bold{u} - \\bold{v}\\rVert^2 = 2\\left(\\langle \\bold{u}, \\bold{v}\\rangle + \\langle \\bold{v}, \\bold{u}\\rangle\\right) = 2\\left(\\langle \\bold{u}, \\bold{v}\\rangle + \\overline{\\langle \\bold{u}, \\bold{v}\\rangle}\\right)$$\n\nKeďže $2\\text{Re}(x) = x + \\overline{x}$, tak dostávame:\n$$\n\\text{Re}\\left(\\langle \\bold{u}, \\bold{v}\\rangle\\right) = \\frac{1}{4}\\left(\\lVert\\bold{u} + \\bold{v}\\rVert^2 - \\lVert\\bold{u} - \\bold{v}\\rVert^2\\right)\n$$\n\nPodobne dostávame:\n$$\n\\begin{align*}\n\\lVert\\bold{u} - i\\bold{v}\\rVert^2 &=\\langle \\bold{u}-i\\bold{v}, \\bold{u}-i\\bold{v} \\rangle = \\langle \\bold{u}, \\bold{u}\\rangle + \\langle \\bold{u}, -i\\bold{v}\\rangle + \\langle -i\\bold{v}, \\bold{u}\\rangle + \\langle -i\\bold{v}, -i\\bold{v}\\rangle \\\\\n&= \\langle \\bold{u}, \\bold{u}\\rangle -i \\langle \\bold{u}, \\bold{v}\\rangle + i\\langle \\bold{v}, \\bold{u}\\rangle + \\langle \\bold{v}, \\bold{v}\\rangle\n\\end{align*}\n$$\n\n$$\n\\begin{align*}\n\\lVert\\bold{u} + i\\bold{v}\\rVert^2 &=\\langle \\bold{u}+i\\bold{v}, \\bold{u}+i\\bold{v} \\rangle = \\langle \\bold{u}, \\bold{u}\\rangle + \\langle \\bold{u}, i\\bold{v}\\rangle + \\langle i\\bold{v}, \\bold{u}\\rangle + \\langle i\\bold{v}, i\\bold{v}\\rangle \\\\\n&= \\langle \\bold{u}, \\bold{u}\\rangle +i \\langle \\bold{u}, \\bold{v}\\rangle - i\\langle \\bold{v}, \\bold{u}\\rangle + \\langle \\bold{v}, \\bold{v}\\rangle\n\\end{align*}\n$$\n\nOdčítaním dostávame:\n$$\n\\lVert\\bold{u} - i\\bold{v}\\rVert^2-\\lVert\\bold{u} + i\\bold{v}\\rVert^2 = -2i\\langle \\bold{u}, \\bold{v}\\rangle +2i\\langle \\bold{v}, \\bold{u}\\rangle = 4\\cdot \\frac{\\langle \\bold{u}, \\bold{v}\\rangle - \\overline{\\langle \\bold{u}, \\bold{v}\\rangle}}{2i}\n$$\n\nKeďže $\\text{Im}(x) = \\frac{x - \\overline{x}}{2i}$, tak:\n$$\n\\text{Im}\\left(\\langle \\bold{u}, \\bold{v}\\rangle\\right) = \\frac{1}{4}\\left(\\lVert\\bold{u} - i\\bold{v}\\rVert^2-\\lVert\\bold{u} + i\\bold{v}\\rVert^2 \\right)\n$$"
      }
    ]
  },
